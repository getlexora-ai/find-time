# find_time — copy to .env.local and fill in.

# Neon Postgres. Two strings from the Neon dashboard:
#   DATABASE_URL           — the -pooler host. Used by the app (src/server/db/pool.ts).
#   DATABASE_URL_UNPOOLED  — the direct host (no -pooler). Used only to apply db/*.sql.
# See db/README.md.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Set to 1 to skip the demo-data seed (src/server/store/seed.ts).
# FT_SKIP_SEED=1
