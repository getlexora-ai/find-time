# Copy to .env.local (gitignored) and fill in.

# ── server only (the +api.ts routes) ──────────────────────────────────────
# Neon connection string. Pooled URL (host has "-pooler") for the running app;
# use the direct URL only to apply db/*.sql. NEVER prefix this EXPO_PUBLIC_ —
# that would ship the DB password inside the app bundle.
DATABASE_URL=
# Direct/unpooled Neon URL (host has NO "-pooler"). Only used to run migrations:
#   psql "$DATABASE_URL_UNPOOLED" -v ON_ERROR_STOP=1 -f db/schema.sql
DATABASE_URL_UNPOOLED=

# ── Clerk auth ───────────────────────────────────────────────────────────
# Clerk owns sign in / sign up / sessions. Dashboard → your DEV instance →
# API keys. The publishable key is bundled into the app (safe to ship); the
# secret key is server-only (the +api.ts routes verify session tokens with it).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Google Calendar connect (server only) ─────────────────────────────────
# Now a calendar-connect grant only (Clerk handles login). Grants
# calendar.readonly for the currently signed-in Clerk user.
#
# One-time Google Cloud setup:
#   1. console.cloud.google.com → create/pick a project
#   2. APIs & Services → Library → enable "Google Calendar API"
#   3. APIs & Services → OAuth consent screen → External, add scopes
#      openid / email / profile / .../auth/calendar.readonly, add yourself as a
#      Test user (leave publishing status "Testing" — no verification needed)
#   4. APIs & Services → Credentials → Create credentials → OAuth client ID →
#      Web application. Add this exact Authorized redirect URI:
#         http://localhost:8081/api/auth/google/callback
#      (add your deployed https URL too, later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/google/callback

# Signs the short-lived Google OAuth `state` param (CSRF).
# 32+ random bytes:  openssl rand -base64 32
SESSION_SECRET=
# Encrypts OAuth tokens at rest (AES-256-GCM). EXACTLY 32 bytes, base64:
#   openssl rand -base64 32
TOKEN_ENC_KEY=

# ── AI "Find time" (server only) ─────────────────────────────────────────
# Anthropic API key for POST /api/ai/find-time (Claude parses the request; a
# deterministic placer picks the slots). Get one at console.anthropic.com.
# Without it the Find time panel returns a 503.
ANTHROPIC_API_KEY=

# ── client (bundled into the app) ────────────────────────────────────────
# Base URL of the API. Leave EMPTY for local web (same-origin /api/...).
# A physical device on the dev server needs your machine's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.x:8081
# Production native builds point at the deployed host:
#   EXPO_PUBLIC_API_URL=https://find-time-production.up.railway.app
EXPO_PUBLIC_API_URL=

# Deployed origin, no trailing slash. Used for the canonical URL and absolute
# Open Graph image in src/app/+html.tsx. Defaults to https://findtime.ai when
# unset — set it on Railway to the real host (robots.txt / sitemap.xml also
# reference findtime.ai; update those two files if the domain differs).
EXPO_PUBLIC_SITE_URL=
